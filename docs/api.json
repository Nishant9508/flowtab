  "components": {
    "schemas": {
      "ChargesResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "data": {
            "items": {
              "type": "object"
            },
            "type": "array",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "status",
          "data"
        ],
        "title": "ChargesResponse"
      },
      "FindingItem": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "severity": {
            "type": "string",
            "title": "Severity"
          },
          "cost_impact": {
            "type": "number",
            "title": "Cost Impact"
          }
        },
        "type": "object",
        "required": [
          "title",
          "description",
          "severity",
          "cost_impact"
        ],
        "title": "FindingItem"
      },
      "FindingsResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/FindingItem"
            },
            "type": "array",
            "title": "Findings"
          }
        },
        "type": "object",
        "required": [
          "status",
          "findings"
        ],
        "title": "FindingsResponse"
      },
      "FlowItem": {
        "properties": {
          "sender_type": {
            "type": "string",
            "title": "Sender Type"
          },
          "sender_name": {
            "type": "string",
            "title": "Sender Name"
          },
          "receiver_type": {
            "type": "string",
            "title": "Receiver Type"
          },
          "receiver_name": {
            "type": "string",
            "title": "Receiver Name"
          },
          "route": {
            "type": "string",
            "title": "Route"
          },
          "charge_category": {
            "type": "string",
            "title": "Charge Category"
          },
          "gb": {
            "type": "number",
            "title": "Gb"
          },
          "usd": {
            "type": "number",
            "title": "Usd"
          }
        },
        "type": "object",
        "required": [
          "sender_type",
          "receiver_type",
          "route",
          "charge_category",
          "gb",
          "usd"
        ],
        "title": "FlowItem"
      },
      "FlowsResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "data": {
            "items": {
              "$ref": "#/components/schemas/FlowItem"
            },
            "type": "array",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "status",
          "data"
        ],
        "title": "FlowsResponse"
      },
      "GenerateDemoRequest": {
        "properties": {
          "account_id": {
            "type": "string",
            "title": "Account Id",
            "default": "demo-123456"
          },
          "region": {
            "type": "string",
            "title": "Region",
            "default": "us-east-1"
          }
        },
        "type": "object",
        "title": "GenerateDemoRequest"
      },
      "GenericResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "data": {
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "GenericResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SummaryResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "total_gb": {
            "type": "number",
            "title": "Total Gb"
          },
          "total_usd": {
            "type": "number",
            "title": "Total Usd"
          },
          "by_category": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "By Category"
          }
        },
        "type": "object",
        "required": [
          "status",
          "total_gb",
          "total_usd",
          "by_category"
        ],
        "title": "SummaryResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
